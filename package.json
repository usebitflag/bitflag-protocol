{
  "name": "bitflag-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "BitFlag delivery schemas, specification and conformance fixtures",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "node tools/validate.mjs",
    "manifest": "node tools/manifest.mjs",
    "bucket": "node tools/bucket.mjs --write",
    "canonical": "node tools/canonical.mjs --write",
    "checksum": "node tools/checksum.mjs --write",
    "pack": "node tools/pack.mjs",
    "compare": "node tools/compare-reports.mjs",
    "fuzz:generate": "node tools/fuzz/generate.mjs",
    "fuzz:compare": "node tools/fuzz/compare.mjs",
    "manifest:check": "node tools/manifest.mjs --check",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "npm run validate && npm run manifest:check && npm run lint:md"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "markdownlint-cli2": "^0.24.0"
  }
}
